; Engine configuration file.
; Driver - off-road co-op driving

config_version=5

[application]

config/name="Driver"
config/description="Off-road driving, solo or with up to three friends over LAN or Tailscale."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.07, 0.066, 0.06, 1)
boot_splash/show_image=false
config/windows_native_icon="res://icon.ico"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
Net="*res://scripts/autoload/net.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.07, 0.066, 0.06, 1)
lights_and_shadows/directional_shadow/size=4096
